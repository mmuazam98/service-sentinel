FROM golang:1.22-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO_ENABLED=0 produces a static binary, so it runs on a scratch base.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /service-sentinel ./cmd

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app

# Bundled default config. In Kubernetes, mount a ConfigMap and point
# CONFIG_PATH at it instead.
COPY --from=builder /app/config/config.yaml ./config/config.yaml
COPY --from=builder /service-sentinel /usr/local/bin/service-sentinel

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/service-sentinel"]
